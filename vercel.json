{
  "rewrites": [
    { "source": "/((?!api/|\\.well-known/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/forgot-password",
      "headers": [
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json" }
      ]
    }
  ]
}
